OLLAMA_BASE_URL=http://localhost:11434
PDF_MODEL=gemma3:12b
EMBED_MODEL=mxbai-embed-large
CHROMA_PATH=chroma_db_v5
MAX_LLM_CALLS_PDF=4

#set this to True for IR and False for SMAC
USE_LLM_PARSER=true

USE_OLLAMA_EMBEDDINGS=false

# ── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=isd-intelligence-local-dev-secret-key-change-in-prod
JWT_EXPIRE_HOURS=24

# Whisper STT (local, offline)
WHISPER_MODEL=small

# RAG Accuracy Features
ENABLE_HYBRID_SEARCH=true
ENABLE_MULTI_QUERY=true
ENABLE_RERANKING=true

# Embedding method: true = Ollama HTTP, false = sentence-transformers direct GPU
USE_OLLAMA_EMBEDDINGS=false

# Prevent sentence-transformers from contacting HuggingFace (fully offline)
HF_HUB_OFFLINE=1

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Sandy@411
MYSQL_DATABASE=ISDIntelligence
