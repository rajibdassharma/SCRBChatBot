OLLAMA_BASE_URL=http://localhost:11434
PDF_MODEL = gemma3:12b
EMBED_MODEL = mxbai-embed-large
CHROMA_PATH=chroma_db_v4

# ── Authentication ─────────────────────────────────────────────────────────────
# Change this to a long random secret before deploying to production
JWT_SECRET_KEY=isd-intelligence-local-dev-secret-key-change-in-prod
JWT_EXPIRE_HOURS=24

# Whisper STT (local, offline) — tiny/base/small/medium/large
WHISPER_MODEL=small

# RAG Accuracy Features (set to false to disable)
ENABLE_HYBRID_SEARCH=true
ENABLE_MULTI_QUERY=true
ENABLE_RERANKING=true

# ── SQL Server (MSSQL) ────────────────────────────────────────────────────────
# Server name — common values: localhost, localhost\SQLEXPRESS, .\SQLEXPRESS
MSSQL_SERVER=localhost
MSSQL_DATABASE=ISDIntelligenceV4
# ODBC driver — use "ODBC Driver 18 for SQL Server" if 17 is not installed
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Auth mode: "windows" (Trusted_Connection) or "sql" (username/password)
MSSQL_AUTH=windows
# Only needed when MSSQL_AUTH=sql
MSSQL_USER=
MSSQL_PASSWORD=
