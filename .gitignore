# Dependencies
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Environment / secrets — never commit
**/.env
**/.env.local
**/.env.*.local

# Vector Database / Chroma
**/chroma_store/
**/chroma_db/
**/chroma_db_v3/
**/chroma_db_v4/
**/chroma_db_v5/
**/chroma_db_playground/
**/chroma_db_gcp/
**/chroma_db_ir_v6/
**/chroma_db_smac_v6/

# Local data caches
**/data/*.txt
**/data/manifest.json
**/questions.db
**/*.smac_bulk_progress*
**/*.ir_bulk_progress*

# Seed credentials — generated by seed.py, must never be committed
**/seed_credentials_*.csv

# Claude internal config
.claude/

# SQLite databases
*.db
*.sqlite3

# Debug audio recordings
**/debug_audio/

# macOS
.DS_Store

# Large data files
FraudDB_DataNew/

# Large PDF files
**/CompleteEnglish2022.pdf

# Large video files
*.mp4
*.avi
*.mov

# Junk file
nul

# Build artifacts
**/dist/
**/build/

# IDE
.vscode/
.idea/

