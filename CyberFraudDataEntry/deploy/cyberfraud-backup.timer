[Unit]
Description=Nightly backup of cyber_fraud_dsr + uploads/ at 00:00 IST

[Timer]
# 00:00 IST (= 18:30 UTC the previous day). Explicit Asia/Kolkata makes
# this safe regardless of whether the server's local timezone is UTC,
# IST, or something else.
OnCalendar=*-*-* 00:00:00 Asia/Kolkata

# If the server was off at the trigger time, fire on next boot.
Persistent=true

# Up to 5 minutes of randomised delay to spread load if other timers
# also fire at 00:00.
RandomizedDelaySec=5min

Unit=cyberfraud-backup.service

[Install]
WantedBy=timers.target
