[Unit]
# Replaces cyberfraud-backup.service AND cyberfraud-analysis.service.
# Those ran on two timers an hour apart, which ordered them by clock
# rather than by dependency: the backup fired at 00:00 and the analysis
# at 01:00, so every backup carried the PREVIOUS day's analysis. One
# unit running both in sequence is what makes "the backup contains
# today's analysis" true rather than usually true.
Description=CyberFraud Data Entry — nightly analysis then backup
After=mysql.service network-online.target
Requires=mysql.service

[Service]
Type=oneshot
User=cyberfraud
Group=cyberfraud
WorkingDirectory=/opt/cyberfraud
ExecStart=/opt/cyberfraud/deploy/nightly-all.sh

# Memory the analysis workers must leave free. runtime.py budgets
# workers from FREE memory rather than core count, so this is the one
# number that decides how hard the box is pushed.
#
# 4 GB on a 16 GB VM: roughly 3 GB for the OS and Gunicorn, 4 GB for
# the InnoDB buffer pool, leaving the parser the rest. It was 2.0 when
# this box was believed to have 8 GB.
Environment=CFDSR_ANALYSIS_RESERVE_GB=4.0

# Idle timeout: how long governed_map waits with NOTHING completing
# before it decides the pool is dead, cancels the batch and rebuilds.
#
# The 300s default was calibrated on a laptop where no single statement
# ever came close to it. On this box the first night fired it 36 times
# and abandoned 432 of 1,152 files -- 37% -- because one slow PDF in a
# chunk starves the whole chunk of completions. Those files are marked
# worker-died and retried next run, so nothing was lost except four
# hours.
#
# 1800s still catches a genuinely dead pool in one interval. It just
# stops mistaking "slow" for "dead" on hardware an order of magnitude
# slower than where the number was chosen.
Environment=CFDSR_ANALYSIS_IDLE_TIMEOUT_S=1800

# LAST RESORT ONLY. This timeout kills the whole unit -- backup
# included -- which is exactly what happened on the first night: the
# analysis was still hashing photos at 8h, systemd terminated
# everything, and no backup was taken.
#
# nightly-all.sh now gives the analysis its own 6h budget, so an
# overrun ends the analysis and still leaves time to back up. This
# number only fires if the SCRIPT itself wedges, which the analysis
# budget should make impossible.
TimeoutStartSec=10h

# Deprioritised against the web application. 90 operators can be on
# this box at any hour, and none of them should wait on a batch job.
# Deprioritised against the web application, but NOT starved.
#
# IOSchedulingClass=idle was the first attempt and it is the wrong tool
# here: this workload is almost entirely I/O -- reading PDFs, writing
# rows to MySQL -- so "only run when the disk is otherwise idle" on a
# box serving 90 operators means barely running at all. Measured on the
# first night: 12.54s/file against 1.15s/file on a laptop doing the
# same work.
#
# best-effort at priority 6 (0 is highest, 7 lowest) still yields to
# the app's queries while letting the parser make progress.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
CPUSchedulingPolicy=batch

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ProtectSystem=strict makes the filesystem read-only except these two.
# backups/ takes the dump and the tarball. backend/ is needed because
# the venv lives there (/opt/cyberfraud/backend/venv) and Python writes
# __pycache__ on import. uploads/ is deliberately absent: the parser
# only reads it, and reading is allowed.
ReadWritePaths=/opt/cyberfraud/backups /opt/cyberfraud/backend

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
