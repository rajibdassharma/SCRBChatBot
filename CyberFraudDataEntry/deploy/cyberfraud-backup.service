[Unit]
Description=CyberFraud Data Entry — nightly backup (DB + uploads)
After=mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=cyberfraud
Group=cyberfraud
WorkingDirectory=/opt/cyberfraud
# backup-all.sh is the one-shot wrapper that runs backup-db.sh then
# backup-uploads.sh in sequence. Fails loudly if either step fails so
# the service unit records failure and the journal shows which half
# broke.
ExecStart=/opt/cyberfraud/deploy/backup-all.sh

# Hardening — backup reads .env + uploads/, writes backups/, talks to MySQL.
# /opt is still readable under ProtectSystem=strict; only writes need
# to be whitelisted, so ReadWritePaths=/opt/cyberfraud/backups is enough
# for both the DB dump and the uploads tar.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/cyberfraud/backups

StandardOutput=journal
StandardError=journal

# Triggered by .timer — no [Install] section in the .service itself
