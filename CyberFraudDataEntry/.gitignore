# Python
__pycache__/
*.pyc
*.pyo
backend/.env

# Node
frontend/node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# ─── Sensitive: never commit ─────────────────────────────────────
# Real production data that landed in this folder for local work.
# Every entry below is a live tripwire for `git add -A`.

# Operator credentials — one-time password lists, never in git.
backend/Passwords*.csv
backend/Passwords*.xlsx
backend/Production_passwords*.xlsx
backend/Production_passwords*.csv
# seed.py writes every seeded user's PLAINTEXT password here. It was
# not ignored until 2026-08-22, which meant one `git add backend/`
# after a seed would have published ~88 live credentials.
backend/seed_credentials.csv
backend/*credentials*.csv

# XSS / pen-test payloads left over from VAPT — not for public repo.
backend/case_xss.json

# Live user-uploaded files (accused photos, bank statements).
# The dir exists on disk with real evidence; commit nothing under it.
backend/uploads/

# DB snapshots — production data at rest. Restore locally, never push.
# dump-schema.sh writes schema-only snapshots here too; commit those
# explicitly with `git add -f proddata/schema-snapshot-YYYYMMDD.sql`
# if you want to preserve a dated schema artefact.
proddata/*.sql
proddata/*.sql.gz
proddata/*.tar.gz
!proddata/README.md              # keep docs about proddata/, if any

# Bank-provided operator working files that ended up here by accident.
CyberCrimeData/
*BankAction*.xlsx
DSR*formate*.xlsx
All District*.xlsx
# ...EXCEPT the PS roster. It is reference master data, not case data --
# 44 rows of district + station name, all of it public -- and seed.py
# builds units + police_stations from it. Without it seed.py falls back
# to AllDistrictPS.xlsx: 1,085 stations across 40 districts instead of
# 44 across 36, two users each, a failure that looks like a successful
# run. It travels with the code so a green-field build cannot miss it.
!All District CEN_PS.xlsx

# The BACKUP DUMPS never go in git, whatever else does. They are the
# whole database and the whole uploads tree -- victim PII, bank
# statements, ID photos -- and one of them is 21 GB.
dbdump*.sql*
dbdump*.gz
filedump*.tar*
filedump*.gz
*.sql.gz

# IFSC directory: import source for the ifsc_branch table, not code.
# 35 MB that every clone and deploy would carry forever. Downloaded
# from github.com/razorpay/ifsc releases and scp'd to the server once;
# after loading it lives in the DB and travels in the nightly backup.
proddata/IFSC.csv
